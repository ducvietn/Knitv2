# Biến môi trường cho bản deploy.
# Copy file này thành `.env` ở thư mục gốc rồi điền giá trị thật.

# Bắt buộc — chuỗi bí mật dùng ký JWT.
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
KNIT_SECRET=

# Cổng của API (nếu chạy trực tiếp không qua reverse proxy).
PORT=4000

# --------------------------------------------------------------- cơ sở dữ liệu
#
# KNIT chạy được trên hai loại DB:
#
# - `sqlite`  — file đơn, mặc định ở local. Không cần cài server.
# - `postgres` — dùng khi deploy (Supabase). Cần có `DATABASE_URL`.
#
# Để trống = tự chọn: có `DATABASE_URL` thì dùng Postgres, không thì SQLite.
#   postgres
#   sqlite
KNIT_DB_DRIVER=

# Chuỗi kết nối Postgres (Supabase).
#
# ⚠️ Chọn đúng loại chuỗi — đây là chỗ hay bị nhầm nhất:
#
# 1) Direct connection — chỉ có IPv6 (AAAA record):
#      postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#    ❌ Không dùng được nếu máy/host KHÔNG có IPv6 native.
#       Render có IPv6 egress nên dùng được; máy local Windows thường không.
#
# 2) Pooler (khuyến nghị cho IPv4, ổn định hơn):
#      postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#    ✅ Hỗ trợ cả IPv4 lẫn IPv6. Dùng "Session pooler" (port 5432).
#    ⚠️ Cần bật Connection Pooler trong Dashboard (Database > Connection Pooler).
#
# Supabase yêu cầu SSL — nên thêm `?sslmode=require` nếu URL chưa có.
#
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# ------------------------------------------------------- SQLite (khi dùng sqlite)

# Đường dẫn file SQLite. Mặc định ./data/knit.db
KNIT_DB=./data/knit.db

# Thư mục lưu ảnh avatar do người dùng tải lên.
# Mặc định ./data/avatars
KNIT_AVATAR_DIR=./data/avatars

# ------------------------------------------------- Supabase Storage (avatar)
#
# Bật khi muốn ảnh avatar sống sót qua các lần restart container
# (Render free không có persistent disk).
# Khi để trống, ảnh lưu trên filesystem (`KNIT_AVATAR_DIR`).
#
# Tạo bucket: Supabase Dashboard > Storage > New bucket, tên `avatars`,
# và bật "Public" để ảnh hiển thị trực tiếp trên web.
#
#   https://<project-ref>.supabase.co
SUPABASE_URL=

# Service role key (Project Settings > API). Dùng anon key cũng được,
# nhưng bucket private sẽ cần service role key.
SUPABASE_SERVICE_ROLE_KEY=

# Tên bucket trong Supabase Storage. Mặc định `avatars`.
SUPABASE_STORAGE_BUCKET=avatars

# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy.
# Để trống nếu web và API cùng origin (khuyến nghị).
KNIT_CORS_ORIGINS=
