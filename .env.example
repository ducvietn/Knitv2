# Biến môi trường cho bản deploy.
# Copy file này thành `.env` ở thư mục gốc rồi điền giá trị thật.

# Bắt buộc — chuỗi bí mật dùng ký JWT.
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
KNIT_SECRET=

# Cổng của API (nếu chạy trực tiếp không qua reverse proxy).
PORT=4000

# Đường dẫn file SQLite. Mặc định ./data/knit.db
KNIT_DB=./data/knit.db

# Thư mục lưu ảnh avatar do người dùng tải lên.
# Mặc định ./data/avatars
KNIT_AVATAR_DIR=./data/avatars

# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy.
# Để trống nếu web và API cùng origin (khuyến nghị).
KNIT_CORS_ORIGINS=
