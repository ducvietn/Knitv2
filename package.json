{
  "name": "knit-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:app": "npm --prefix app run dev",
    "dev:server": "npm --prefix server run dev",
    "seed": "npm --prefix server run seed",
    "seed:pg": "npm --prefix server run seed:pg",
    "migrate": "npm --prefix server run migrate",
    "export-seed": "tsx scripts/export-seed.ts",
    "build:schema": "node scripts/build-schema.mjs",
    "build": "npm run build:schema && npm --prefix server run build && npm --prefix app run build",
    "start": "npm --prefix server run start",
    "typecheck": "npm --prefix server run typecheck && npm --prefix app run lint",
    "preview": "npm run build && npm run start",
    "test:pg": "tsx scripts/test-postgres.mjs",
    "test:pg-e2e": "tsx scripts/test-pg-e2e.mjs",
    "test:avatar": "tsx scripts/test-avatar-storage.mjs",
    "smoke:sqlite": "tsx scripts/smoke-sqlite.mjs",
    "smoke:postgres": "tsx scripts/smoke-postgres.mjs",
    "smoke:pg": "node scripts/smoke-pg.mjs",
    "deploy:supabase": "node scripts/setup-supabase.mjs",
    "deploy:storage": "node scripts/setup-storage.mjs",
    "verify:db": "node scripts/verify-db.mjs",
    "test": "npm run test:pg && npm run test:pg-e2e && npm run test:avatar && npm run smoke:sqlite && npm run smoke:postgres"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
